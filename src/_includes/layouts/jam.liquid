---
layout: layouts/base
---
<div class="base--main__jam">
  <header class="page-intro">
    <h1 class="page-title">A Jam</h1>
    <p class="page-subtitle">
      Play links from <a href="https://www.crucialtracks.org">Crucial Tracks</a>
      and <a href="https://odesli.co">Songlink</a>
    </p>
  </header>
  <div class="a-jam flow">
    {% if tags and "crucial" in tags %}
    <p class="single-crucial-jam"><a href="/jams/crucial">crucial</a></p>
    {% endif %}
    <p class="timestamp">{{ date | postDate }}</p>
    <h2>{{songTitle}} by {{artist}}</h2>
    <picture>
      <img src="{{imageUrl}}" alt="Cover for {{title}} - {{artist}}" />
    </picture>
    <ul class="jam-streaming-list">
      <li class="timestamp">Play:</li>
      {% if links.spotify != blank %}
      <li>
        <a href="{{links.spotify}}"
          ><img
            src="/assets/images/icons/spotify-icon.svg"
            alt="Play on Spotify"
        /></a>
      </li>
      {% endif %} {% if links.appleMusic != blank %}
      <li>
        <a href="{{links.appleMusic}}"
          ><img
            src="/assets/images/icons/apple-music-icon.svg"
            alt="Play on Apple Music"
        /></a>
      </li>
      {% endif %} {% if links.bandcamp != blank %}
      <li>
        <a href="{{links.bandcamp}}"
          ><img
            src="/assets/images/icons/bandcamp-icon.svg"
            alt="Listen on Bandcamp"
            eleventy:ignore
        /></a>
      </li>
      {% endif %} {% if links.songlink != blank %}
      <li>
        <a href="{{links.songlink}}"
          ><img
            src="/assets/images/icons/songlink-icon.png"
            alt="All streaming platforms on Songlink"
            eleventy:widths="56"
            eleventy:formats="webp,png"
        /></a>
      </li>
      {% endif %} {% if links.amazon != blank %}
      <li>
        <a href="{{links.amazon}}"
          ><img
            src="/assets/images/icons/amazon-music-icon.svg"
            alt="Play on Amazon Music"
        /></a>
      </li>
      {% endif %} {% if links.youtubeMusic != blank %}
      <li>
        <a href="{{links.youtubeMusic}}"
          ><img
            src="/assets/images/icons/youtube-music-icon.svg"
            alt="Play on YouTube Music"
        /></a>
      </li>
      {% endif %} {% if links.tidal != blank %}
      <li>
        <a href="{{links.tidal}}"
          ><img src="/assets/images/icons/tidal-icon.svg" alt="Play on Tidal"
        /></a>
      </li>
      {% endif %} {% if links.soundcloud != blank %}
      <li>
        <a href="{{links.soundcloud}}"
          ><img
            src="/assets/images/icons/soundcloud-icon.svg"
            alt="Play on SoundCloud"
        /></a>
      </li>
      {% endif %}
    </ul>
  </div>
  <div class="jam-commentary flow" style="--flow-space: 2rem">{{ content  }}</div>
</div>
