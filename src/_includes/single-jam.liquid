<div class="single-jam flow">
  {% if jam.tags and "crucial" in jam.tags %}
  <p class="single-crucial-jam crucial-jam"><a href="/jams/crucial">crucial</a></p>
  {% endif %}
  <p class="timestamp">{{ jam.date | postDate }}</p>
  {% if jamUrl != empty %}
  <a href="{{ jamUrl }}">
    {% endif %}
    <h2>{{jam.songTitle}} by {{jam.artist}}</h2>
    {% if jamUrl != empty %}
  </a>
  {% endif %} {% if jamUrl != empty %}
  <a href="{{ jamUrl }}">
    {% endif %}
    <picture>
      <img
        src="{{jam.imageUrl}}"
        alt="Cover for {{jam.title}} - {{jam.artist}}"
      />
    </picture>
    {% if jamUrl != empty %}
  </a>
  {% endif %}
  <ul class="jam-streaming-list">
    <li class="timestamp">Play:</li>
    {% if jam.links.spotify != empty %}
    <li>
      <a href="{{jam.links.spotify}}"
        ><img src="/assets/images/icons/spotify-icon.svg" alt="Play on Spotify"
      /></a>
    </li>
    {% endif %} {% if jam.links.appleMusic != empty %}
    <li>
      <a href="{{jam.links.appleMusic}}"
        ><img
          src="/assets/images/icons/apple-music-icon.svg"
          alt="Play on Apple Music"
      /></a>
    </li>
    {% endif %} {% if jam.links.amazon != empty %}
    <li>
      <a href="{{jam.links.amazon}}"
        ><img
          src="/assets/images/icons/amazon-music-icon.svg"
          alt="Play on Amazon Music"
      /></a>
    </li>
    {% endif %} {% if jam.links.youtubeMusic != empty %}
    <li>
      <a href="{{jam.links.youtubeMusic}}"
        ><img
          src="/assets/images/icons/youtube-music-icon.svg"
          alt="Play on YouTube Music"
      /></a>
    </li>
    {% endif %} {% if jam.links.tidal != empty %}
    <li>
      <a href="{{jam.links.tidal}}"
        ><img src="/assets/images/icons/tidal-icon.svg" alt="Play on Tidal"
      /></a>
    </li>
    {% endif %} {% if jam.links.soundcloud != empty %}
    <li>
      <a href="{{jam.links.soundcloud}}"
        ><img
          src="/assets/images/icons/soundcloud-icon.svg"
          alt="Play on SoundCloud"
      /></a>
    </li>
    {% endif %}
  </ul>
</div>
